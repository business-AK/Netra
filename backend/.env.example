DATABASE_URL=sqlite:///./storage/videorag.db
STORAGE_DIR=./storage
VISUAL_MODEL=ViT-B-32
PRETRAINED_VISUAL=openai
WHISPER_MODEL=base
TEXT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# VLM Inference Provider options:
# - "ollama": Local offline models (e.g. qwen2.5-vl:7b, llama3.2-vision:11b)
# - "gemini": Google Gemini (gemini-2.0-flash, gemini-1.5-flash)
# - "groq": Groq Cloud Vision (llama-3.2-11b-vision-preview)
# - "lmstudio": Local OpenAI-compatible server (http://localhost:1234/v1)
# - "openai": OpenAI GPT-4o
# - "openrouter": OpenRouter models
VLM_PROVIDER=ollama
VLM_MODEL=qwen2.5-vl:7b
VLM_BASE_URL=http://localhost:11434

# API Keys (leave blank for local Ollama / LM Studio)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Ingestion & Retrieval parameters
FRAME_SAMPLING_FPS=1
TOP_K_VISUAL=10
TOP_K_TEXT=5
MAX_VLM_IMAGES=8
TEMPORAL_WINDOW_SECONDS=2.0
